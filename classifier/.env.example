# Recognition service (holotrace-ml serve). Copy to .env on the serving host; never commit real values.
# Generate a key with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HOLOTRACE_ML_API_KEY=

# Service settings. Keep the default host when a reverse proxy runs on this machine.
# Set HOLOTRACE_ML_HOST to the server's Tailscale IP for direct tailnet access.
HOLOTRACE_ML_HOST=127.0.0.1
HOLOTRACE_ML_PORT=8000
HOLOTRACE_ML_REGISTRY=models
HOLOTRACE_ML_THREADS=4
HOLOTRACE_ML_MAX_UPLOAD_MB=20
