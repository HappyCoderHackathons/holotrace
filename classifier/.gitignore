.venv/
__pycache__/
*.py[cod]
.ruff_cache/

# Datasets, derived crops, training runs, and weights stay out of git
data/
runs/
models/
previews/
*.pt
*.pth
*.onnx

# The two release checkpoints in weights/ are deliberately versioned so a
# fresh checkout can run inference without access to the training server.
!weights/**/*.pt
