# Read by circuit-stuff/recognize.ts (Bun reads a .env in the folder you run it from). Copy to .env and fill in;
# .env is git-ignored. The key is never passed on the command line and never printed.

# The model API address. Use https for anything that is not this machine or on Tailscale.
HOLOTRACE_MODEL_API_URL=https://your-model-api.example

# The bearer key the service was started with (see classifier/README.md).
HOLOTRACE_ML_API_KEY=replace-with-the-service-key

# Instead of HOLOTRACE_MODEL_API_URL, the script can use the classifier service's own settings:
# HOLOTRACE_ML_HOST=100.x.y.z
# HOLOTRACE_ML_PORT=8000
