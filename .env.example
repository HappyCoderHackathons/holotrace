# Values prefixed with PUBLIC_ may be bundled into the Svelte client.
# Never place database credentials, ML service keys, object-storage secrets,
# or other privileged values in a client-visible variable.
PUBLIC_API_BASE_URL=http://localhost:8000
# The deployed Better Auth service. Override this only when running auth locally.
PUBLIC_AUTH_BASE_URL=https://api.ifyousmellityouwilleventuallydie.tech

# The native Tauri process reads these values. Since they do not use the
# PUBLIC_ prefix, Vite does not expose them to the Svelte webview.
#
# A packaged build ships no .env beside it, and Android has no filesystem
# location to read one from, so src-tauri/build.rs bakes whatever is set at
# build time into the binary as a fallback. The process environment and this
# file still win at runtime. CI supplies both from repository secrets of the
# same name.
#
# The consequence is that HOLOTRACE_ML_API_KEY is recoverable from a released
# binary. That is true of any credential a client holds; putting the model API
# behind per-user authentication is the only real fix, and is not implemented.
HOLOTRACE_MODEL_API_URL=http://localhost:8000
HOLOTRACE_ML_API_KEY=replace-with-a-random-value-of-at-least-32-characters

# Future server and worker services should define their own .env.example files
# beside those services once their runtime configuration is implemented.
