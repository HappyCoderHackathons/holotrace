# PostgreSQL connection used only by the server. Never expose this through Vite.
DATABASE_URL=postgresql://holotrace:change-me@localhost:5432/holotrace

# Public URL at which Caddy exposes the Better Auth routes.
BETTER_AUTH_URL=http://localhost:8001

# Generate a high-entropy value of at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-random-value-of-at-least-32-characters

# Comma-separated client origins allowed to make credentialed auth requests.
AUTH_TRUSTED_ORIGINS=http://localhost:5173

# Optional defense in depth for Caddy's private forward_auth request.
INTERNAL_AUTH_TOKEN=replace-with-a-separate-random-value

# The Bun service's private listening port.
BIND_HOST=127.0.0.1
PORT=8001
